rules_version = '2';

// ==============================================================
// StadiumOps AI — Firestore Security Rules (Public Demo)
// --------------------------------------------------------------
// This is a PUBLIC DEMO with no auth. Rules are intentionally
// permissive for reads but validate writes via allow-if rules.
// Phase 3+ will add auth and tighten these rules.
// ==============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Read-only collections (public read, no client writes) ----
    // Stadiums, matches, crowd zones, announcements are seeded via
    // admin SDK or Firebase Console — clients can only read.

    match /stadiums/{stadiumId} {
      allow read: if true;
      allow write: if false;
    }

    match /stadiums/{stadiumId}/crowdZones/{zoneId} {
      allow read: if true;
      allow write: if false;
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- Incidents (public create, public read, no delete) ----
    // Anyone can report an incident. Anyone can view incidents.
    // Validates required fields and length limits on create.
    match /incidents/{incidentId} {
      allow read: if true;

      allow create: if request.resource.data.stadiumId is string
        && request.resource.data.stadiumId.size() >= 3
        && request.resource.data.stadiumId.size() <= 64
        && request.resource.data.zoneId is string
        && request.resource.data.zoneId.size() >= 3
        && request.resource.data.zoneId.size() <= 64
        && request.resource.data.category is string
        && request.resource.data.category in [
          'medical', 'security', 'fire', 'crowd_flow',
          'lost_child', 'facilities', 'other'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 140
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 1000
        && request.resource.data.severity is string
        && request.resource.data.severity in ['low', 'medium', 'high', 'critical']
        // Force server-set fields — clients cannot set these
        && !('createdAt' in request.resource.data)
        && !('updatedAt' in request.resource.data)
        && !('status' in request.resource.data)
        && !('assignedResponderUid' in request.resource.data)
        && !('resolutionNotes' in request.resource.data);

      // No updates or deletes from clients (admin only via Admin SDK)
      allow update: if false;
      allow delete: if false;
    }

    // ---- Chat sessions (not used in public demo — stateless chat) ----
    match /chatSessions/{sessionId} {
      allow read, write: if false;
    }

    match /chatSessions/{sessionId}/messages/{messageId} {
      allow read, write: if false;
    }

    // ---- Users (not used in public demo — no auth) ----
    match /users/{uid} {
      allow read, write: if false;
    }

    // ---- Default deny (defense in depth) ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
