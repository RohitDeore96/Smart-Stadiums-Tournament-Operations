rules_version = '2';

// ==============================================================
// StadiumOps AI — Firestore Security Rules
// --------------------------------------------------------------
// Requires authentication for all reads and writes.
// Public read is disabled — clients must sign in (anonymous auth
// is sufficient for the demo) before accessing any collection.
// Write operations have field-level validation.
// ==============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helper functions ----
    function isSignedIn() {
      return request.auth != null;
    }

    // ---- Read-only collections (auth required, no client writes) ----
    match /stadiums/{stadiumId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /stadiums/{stadiumId}/crowdZones/{zoneId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---- Incidents (auth required, validated creates) ----
    match /incidents/{incidentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.stadiumId is string
        && request.resource.data.stadiumId.size() >= 3
        && request.resource.data.stadiumId.size() <= 64
        && request.resource.data.zoneId is string
        && request.resource.data.zoneId.size() >= 3
        && request.resource.data.zoneId.size() <= 64
        && request.resource.data.category is string
        && request.resource.data.category in [
          'medical', 'security', 'fire', 'crowd_flow',
          'lost_child', 'facilities', 'other'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 140
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.description.size() <= 1000
        && request.resource.data.severity is string
        && request.resource.data.severity in ['low', 'medium', 'high', 'critical']
        && !('createdAt' in request.resource.data)
        && !('updatedAt' in request.resource.data)
        && !('status' in request.resource.data)
        && !('assignedResponderUid' in request.resource.data)
        && !('resolutionNotes' in request.resource.data);

      allow update: if isSignedIn();
      allow delete: if false;
    }

    // ---- Chat sessions (auth required, owner-only) ----
    match /chatSessions/{sessionId} {
      allow read, write: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /chatSessions/{sessionId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ---- Users (auth required, owner-only) ----
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- Default deny (defense in depth) ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
