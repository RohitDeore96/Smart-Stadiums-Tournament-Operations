{
  "name": "stadiumops-ai",
  "version": "0.3.0",
  "private": true,
  "description": "StadiumOps AI \u2014 GenAI-enabled stadium operations platform for FIFA World Cup 2026",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @stadiumops/web dev",
    "dev:api": "vercel dev",
    "build": "pnpm --filter @stadiumops/shared build && pnpm --filter @stadiumops/web build",
    "test": "pnpm -r --stream test && vitest run --config api/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:installed": "playwright install --with-deps chromium",
    "lint": "pnpm -r --stream lint && eslint \"api/**/*.ts\" --max-warnings=0",
    "typecheck": "pnpm -r --stream typecheck && tsc --noEmit -p api/tsconfig.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.16.10",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vercel/node": "^3.2.10",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.2"
  },
  "dependencies": {
    "@stadiumops/shared": "workspace:*",
    "lru-cache": "^11.0.1",
    "zod": "^3.23.8"
  }
}
