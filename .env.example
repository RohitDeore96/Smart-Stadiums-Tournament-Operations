# ==============================================================
# StadiumOps AI — Environment Variable Template
# --------------------------------------------------------------
# Copy to `.env` (never commit the real one).
# In production: secrets are loaded from Google Secret Manager, not env files.
# ==============================================================

# === API (Cloud Run backend) ===
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug          # trace | debug | info | warn | error

# Gemini API key — get from https://aistudio.google.com/app/apikey
# In prod, this comes from Secret Manager (NOT env vars).
GEMINI_API_KEY=

# Firebase Admin SDK — download JSON from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=stadiumops-ai-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=    # include \n escapes if loading from env

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# GenAI cache TTL (ms)
GEMINI_CACHE_TTL_MS=300000

# === Web (Vite frontend — variables MUST be prefixed with VITE_) ===
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=stadiumops-ai-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=stadiumops-ai-dev
VITE_FIREBASE_STORAGE_BUCKET=stadiumops-ai-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=http://localhost:8080
