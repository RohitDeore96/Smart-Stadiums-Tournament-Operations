# ==============================================================
# StadiumOps AI — Environment Variable Template
# --------------------------------------------------------------
# Copy to `.env` (never commit the real one).
# In production: secrets are set as Vercel env vars, not env files.
# ==============================================================

# === API (Vercel serverless) ===
NODE_ENV=development
LOG_LEVEL=debug          # trace | debug | info | warn | error

# Gemini API key — get from https://aistudio.google.com/app/apikey
# Accepts both AIzaSy... (legacy) and AQ.... (newer) formats.
# Set this in Vercel → Settings → Environment Variables.
GEMINI_API_KEY=

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# GenAI cache TTL (ms)
GEMINI_CACHE_TTL_MS=300000

# Auth token for API endpoints (set on Vercel → Settings → Environment Variables)
# If not set in production, ALL API requests are rejected (401).
# In development, any Bearer token is accepted.
AUTH_TOKEN=stadiumops-demo-2026

# Rate limiter — Vercel KV (Upstash Redis) for cross-instance limiting
# Get these from Vercel → Storage → Create Database → Upstash for Redis
# If not set, falls back to in-memory per-instance (documented limitation)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# CSRF — comma-separated list of allowed hosts
ALLOWED_HOSTS=smart-stadiums-tournament-operation-nine.vercel.app

# === Web (Vite frontend — variables MUST be prefixed with VITE_) ===
# Optional — if not set, app uses mock data (realistic MetLife Stadium simulation)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=stadiumops-ai-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=stadiumops-ai-dev
VITE_FIREBASE_STORAGE_BUCKET=stadiumops-ai-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=
