# ==============================================================
# StadiumOps AI — Web env template
# --------------------------------------------------------------
# Copy to `.env.local` and fill in. Vite requires the VITE_ prefix.
# These are PUBLIC values — never put secrets here.
# ==============================================================

# Firebase web config (from Firebase Console > Project Settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=stadiumops-ai-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=stadiumops-ai-dev
VITE_FIREBASE_STORAGE_BUCKET=stadiumops-ai-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# API base URL — use relative path in dev (Vite proxy handles /api → :8080)
VITE_API_BASE_URL=
