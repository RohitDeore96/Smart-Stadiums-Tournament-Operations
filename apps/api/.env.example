# ==============================================================
# StadiumOps AI — API env template
# --------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real `.env` file.
# In production: secrets come from Google Secret Manager, NOT env files.
# ==============================================================

# === Runtime ===
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug          # trace | debug | info | warn | error

# === Gemini API ===
# Get a key from https://aistudio.google.com/app/apikey
# In prod: this comes from Secret Manager (NOT env vars)
GEMINI_API_KEY=

# === Firebase Admin SDK ===
# Project ID is your GCP project ID (same as Firebase project ID)
FIREBASE_PROJECT_ID=stadiumops-ai-dev
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# === CORS ===
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# === Rate limiting ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# === GenAI cache ===
# TTL for cached Gemini responses (ms). 5 min default.
GEMINI_CACHE_TTL_MS=300000
